# Copy to .env.local for development. Never commit real secrets.
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://niceideas:niceideas@127.0.0.1:25434/niceideas
LOGTO_ISSUER=https://id.nicematrix.com/oidc
LOGTO_JWKS_URI=https://id.nicematrix.com/oidc/jwks
FIRST_PARTY_AUDIENCES=https://api.nicematrix.com=nicenote_intl,https://apiv3.ej-mobile.cn=nicenote_cn
# Comma-separated NiceNote Logto client_ids (provided by nicematrix-system agent)
FIRST_PARTY_CLIENT_IDS=
# Media storage: local (dev) or s3 (R2: staging/prod)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./var/storage
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media-local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PRIVATE_BUCKET=
# S3_PUBLIC_BUCKET=
# Where the "From NiceNote" badge on post pages links to
SOURCE_NICENOTE_URL=https://enp.ej-mobile.cn
# 32+ random chars; keys visitor / IP hashes for likes and anonymous comments
# INTERACTION_SECRET=
# Usage analytics, loaded only after consent (empty = off; both empty = no cookie banner)
# ANALYTICS_GA4_ID=G-XXXXXXXXXX
# ANALYTICS_CLARITY_ID=
