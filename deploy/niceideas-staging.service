[Unit]
Description=NiceIdeas (staging) — t.niceideas.app
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/var/www/niceideas-staging/current
EnvironmentFile=/etc/niceideas/env.staging
# glibc keeps per-thread malloc arenas that libvips (sharp) fills and never returns: cap them.
Environment=MALLOC_ARENA_MAX=2
# Several workers on one port (deploy/cluster.mjs); per-worker DB pool = DB_POOL_MAX.
Environment=WEB_CONCURRENCY=4
ExecStart=/usr/bin/node cluster.mjs
Restart=always
RestartSec=3
# Bounded memory for all workers; sharp image work is capped per worker (2 concurrent decodes).
MemoryMax=3G
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
